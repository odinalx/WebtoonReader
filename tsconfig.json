{
  // WXT generates the rest of the config into .wxt/. It leaves `jsx` out: the
  // React module compiles JSX through Vite, which never consults tsconfig, so
  // the build was green while `tsc --noEmit` reported 118 phantom errors across
  // every .tsx file. Setting it here is what makes a typecheck mean anything.
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx"
  }
}
